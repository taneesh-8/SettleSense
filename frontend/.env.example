# Base URL of the SettleSense FastAPI backend (no trailing slash, no /api suffix).
# Local dev: leave unset — api.ts falls back to http://localhost:8000
# Hugging Face Spaces: set to the Space's public URL, e.g.
#   https://<your-username>-settlesense-backend.hf.space
# Railway: set to the backend service's public domain, e.g. https://settlesense-backend.up.railway.app
# Render: set to the backend service's URL, e.g. https://settlesense-backend.onrender.com
VITE_API_URL=
