# Comma-separated list of allowed CORS origins (the deployed frontend's URL).
# Local dev: leave unset — main.py falls back to the local Vite dev ports.
# Vercel: set to the frontend's URL, e.g. https://settlesense.vercel.app
#         (add a preview-deployment URL too, comma-separated, if needed)
# Render: set to the frontend service's URL, e.g. https://settlesense-frontend.onrender.com
#
# On Hugging Face Spaces (Docker SDK): set this as a Space "Variable"
# (Settings -> Variables and secrets), not a "Secret" — it's not sensitive.
FRONTEND_URL=

# Optional — enables Stage 3's real LLM fuzzy matcher instead of the
# heuristic fallback. Leave both unset to run entirely without an LLM key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
